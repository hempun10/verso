# Appwrite configuration (leave blank to run with zero-setup local SQLite + dev login)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Optional Appwrite resource IDs (defaults match scripts/setup_appwrite.py)
APPWRITE_DATABASE_ID=editpdf
APPWRITE_DOCUMENTS_COLLECTION_ID=documents
APPWRITE_ASSETS_COLLECTION_ID=assets
APPWRITE_BUCKET_ID=editpdf_files

# Upload limits aligned with Appwrite Storage (50,000,000 byte max)
EDITPDF_MAX_PDF_BYTES=25000000
EDITPDF_MAX_PDF_PAGES=50
EDITPDF_MAX_IMAGE_BYTES=5000000

# Rate limiting
EDITPDF_RATE_LIMIT_ENABLED=true

# Optional Cloudflare Turnstile CAPTCHA (leave blank to disable locally)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Environment & production security
EDITPDF_ENV=development
EDITPDF_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
EDITPDF_TRUST_PROXY_HEADERS=false
EDITPDF_COOKIE_SECURE=false
# Use "none" (with EDITPDF_COOKIE_SECURE=true) when frontend & backend are on different domains
EDITPDF_COOKIE_SAMESITE=lax

# Local dev auth fallback (MUST be false in production; set a strong >=24-char secret!)
EDITPDF_AUTH_SECRET=change-this-secret-in-production
EDITPDF_ENABLE_DEV_AUTH=true

# Storage quota & cache limits
EDITPDF_STORAGE_QUOTA_BYTES=2000000000
EDITPDF_MAX_CACHED_DOCS=64
EDITPDF_MAX_DISK_CACHE_BYTES=500000000
EDITPDF_OCR_CONCURRENCY=3
