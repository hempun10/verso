# Optional: backend origin when frontend and backend are deployed on separate domains
# Leave blank when serving /api on the same origin (reverse proxy / Vite dev proxy).
VITE_API_BASE_URL=

# Optional: match backend Appwrite settings to enable Google & GitHub OAuth in the browser
# (Frontend also auto-discovers endpoint & project ID from GET /api/auth/config!)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
